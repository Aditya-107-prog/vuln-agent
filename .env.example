# Copy this file to .env and fill in your values
# Get your Groq API key at: https://console.groq.com/keys


# GROQ_API_KEY=xxxxxxxxxxxxxxxxx
# Langfuse (LLM observability/tracing) - https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
# LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Prometheus metrics -----------------------------------------------------
# Bearer token the /metrics scraper must present. Unset = /metrics is OPEN,
# which is fine locally but not on any internet-reachable deploy: /metrics
# runs live Postgres queries per scrape (tools/db_metrics_collector.py), so
# an open endpoint is a free way to generate DB load.
#
# Locally, this must match the literal token in observability/prometheus.yml.
# Generate a real one for Railway with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# METRICS_TOKEN=local-dev-only-metrics-token

# --- Grafana Cloud (Railway "alloy" service only) ---------------------------
# These are read by observability/alloy/config.alloy and belong on the ALLOY
# Railway service, not the web service. The web service only needs
# METRICS_TOKEN (the same value Alloy sends).
#
# Find all three in Grafana Cloud -> your stack -> Prometheus -> "Send Metrics".
# GRAFANA_CLOUD_PROM_URL=https://prometheus-prod-NN-REGION.grafana.net/api/prom/push
# GRAFANA_CLOUD_PROM_USER=1234567            # numeric instance ID, not your email
# GRAFANA_CLOUD_PROM_PASSWORD=glc_xxxxxxxx   # access policy token, metrics:write scope
#
# Optional overrides for the alloy service:
# DEPLOY_ENV=production                              # becomes the env="" label
# VULN_AGENT_TARGET=anchor-backend.railway.internal:5000 # if you renamed the web
#                                                        # service or changed its PORT